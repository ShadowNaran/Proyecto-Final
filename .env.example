# ==========================================
# Variables de entorno - Ejemplo para desarrollo
# Copiar este archivo a .env y ajustar valores
# ==========================================

# Base de datos PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=catalogo_db
PG_HOST_PORT=5433

DB_CONNECTION_STRING=Host=localhost;Port=5433;Database=catalogo_db;Username=postgres;Password=postgres
ConnectionStrings__DefaultConnection=Host=localhost;Port=5433;Database=catalogo_db;Username=postgres;Password=postgres

# Imagen publicada en Docker Hub (usada por docker-compose.release.yml)
DOCKER_IMAGE=abrahdev/proyecto-final:1.0.0

# Puertos de servicios
API_PORT=5174
FRONTEND_PORT=3000

# Frontend, CORS y Data Protection
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5001,http://localhost:5002,http://localhost:5003,http://localhost:5004
DATA_PROTECTION_KEYS_PATH=/app/keys

# Autorización de reportes (Abraham, Marco y Emanuel)
# Reporte Abraham: GET /api/reportes/catalogo-abraham
REPORTE_ALLOWED_PROVIDERS=Auth0,Discord,Spotify,TikTok
REPORTE_ALLOWED_USERS=

# Reporte Marco: GET /api/reportes/comunidad-marco
REPORTE_MARCO_ALLOWED_PROVIDERS=Dropbox,Slack
REPORTE_MARCO_ALLOWED_USERS=

# Reporte Emanuel: GET /api/reportes/talento-emanuel
REPORTE_EMANUEL_ALLOWED_PROVIDERS=Auth0,TikTok
REPORTE_EMANUEL_ALLOWED_USERS=

# Auth0 SSO Centralizado
AUTH0_DOMAIN=dev-cg5j5tsh08gk250m.us.auth0.com
AUTH0_CLIENT_ID=cK0G0lEch5K6kuw5efNFLQNWCdBSndUI
AUTH0_CLIENT_SECRET=tu-client-secret-aqui
AUTH0_CALLBACK_PATH=/signin-auth0

# TikTok Login Kit v2
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_CALLBACK_URL=/signin-tiktok
ALLOWED_TIKTOK_OPEN_ID=

# Credenciales OAuth 2.0 (completar localmente en .env, nunca subir secretos)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_CALLBACK_PATH=/signin-twitch

TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_CALLBACK_PATH=/signin-twitter

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_CALLBACK_PATH=/signin-discord

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_CALLBACK_PATH=/signin-spotify

DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
DROPBOX_CALLBACK_PATH=/signin-dropbox

SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_CALLBACK_PATH=/signin-slack
