# ==========================================
# Variables de entorno - Ejemplo para desarrollo
# Copiar este archivo a .env y ajustar valores
# ==========================================

# Base de datos PostgreSQL
DB_CONNECTION_STRING=Host=localhost;Port=5433;Database=catalogo_db;Username=postgres;Password=postgres
ConnectionStrings__DefaultConnection=Host=localhost;Port=5433;Database=catalogo_db;Username=postgres;Password=postgres

# URL del Frontend
FRONTEND_URL=http://localhost:5174

# Proveedores autorizados para el reporte de catálogo
REPORTE_ALLOWED_PROVIDERS=Auth0,TikTok

# Auth0 SSO Centralizado
AUTH0_DOMAIN=dev-cg5j5tsh08gk250m.us.auth0.com
AUTH0_CLIENT_ID=cK0G0lEch5K6kuw5efNFLQNWCdBSndUI
AUTH0_CLIENT_SECRET=tu-client-secret-aqui
AUTH0_CALLBACK_PATH=/signin-auth0

# TikTok Login Kit v2 (opcional)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_CALLBACK_URL=/signin-tiktok
ALLOWED_TIKTOK_OPEN_ID=
