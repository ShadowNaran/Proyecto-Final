# ============================================================================
# Variables de entorno de ejemplo - Proyecto Final Tecnología Web 1
# ----------------------------------------------------------------------------
# Copiar a .env antes de ejecutar Docker Compose:
#   cp .env.example .env
#
# Este archivo NO contiene secretos reales. Completar las credenciales OAuth
# en el .env local; .env está excluido por .gitignore y nunca se versiona.
# ============================================================================

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=catalogo_db
# Puerto del host para PostgreSQL en desarrollo (el contenedor usa 5432).
PG_HOST_PORT=5433

# Cadena usada por la API al ejecutarse fuera de Docker (dotnet run).
DB_CONNECTION_STRING=Host=localhost;Port=5433;Database=catalogo_db;Username=postgres;Password=postgres
ConnectionStrings__DefaultConnection=Host=localhost;Port=5433;Database=catalogo_db;Username=postgres;Password=postgres

# ---------------------------------------------------------------------------
# Imagen publicada en Docker Hub (docker-compose.release.yml)
# ---------------------------------------------------------------------------
DOCKER_IMAGE=emanuelxd/proyecto-final:1.0.0

# ---------------------------------------------------------------------------
# Puertos de desarrollo (docker-compose.dev.yml)
# ---------------------------------------------------------------------------
API_PORT=5174
FRONTEND_PORT=3000

# ---------------------------------------------------------------------------
# Frontend, CORS y Data Protection
# ---------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5001,http://127.0.0.1:5001,http://localhost:5002,http://127.0.0.1:5002,http://localhost:5003,http://127.0.0.1:5003,http://localhost:5004,http://127.0.0.1:5004
DATA_PROTECTION_KEYS_PATH=/app/keys

# Release multi-instancia: dejar vacío para que el post-login vuelva a la
# misma instancia (5001..5004). Solo definir si existe un frontend separado.
RELEASE_FRONTEND_URL=
# Ruta relativa recomendada para TikTok en release. Cada instancia calcula su
# propio redirect_uri; registrar las 4 URLs en la consola de TikTok.
RELEASE_TIKTOK_CALLBACK_URL=/signin-tiktok

# ---------------------------------------------------------------------------
# Reportes autorizados
# Abraham: GET /api/reportes/catalogo-abraham
# ---------------------------------------------------------------------------
REPORTE_ALLOWED_PROVIDERS=Auth0,Discord,Spotify,TikTok
REPORTE_ALLOWED_USERS=

# Marco: GET /api/reportes/comunidad-marco
REPORTE_MARCO_ALLOWED_PROVIDERS=Dropbox,Slack
REPORTE_MARCO_ALLOWED_USERS=

# Emanuel: GET /api/reportes/talento-emanuel
REPORTE_EMANUEL_ALLOWED_PROVIDERS=Auth0,TikTok
REPORTE_EMANUEL_ALLOWED_USERS=

# ---------------------------------------------------------------------------
# Auth0 SSO (OpenID Connect)
# ---------------------------------------------------------------------------
# Formato del dominio: tu-tenant.us.auth0.com (sin https://)
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_CALLBACK_PATH=/signin-auth0
# Callbacks a registrar en Auth0 (Application > Allowed Callback URLs):
# http://localhost:5174/signin-auth0
# http://localhost:5001/signin-auth0
# http://localhost:5002/signin-auth0
# http://localhost:5003/signin-auth0
# http://localhost:5004/signin-auth0
# https://proyecto-finalupds.onrender.com/signin-auth0

# ---------------------------------------------------------------------------
# TikTok Login Kit v2
# ---------------------------------------------------------------------------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_CALLBACK_URL=/signin-tiktok
# Si se deja vacío se permite cualquier cuenta. Copiar el open_id devuelto
# por el login para restringir el acceso a una sola cuenta.
ALLOWED_TIKTOK_OPEN_ID=

# ---------------------------------------------------------------------------
# Proveedores OAuth 2.0 externos
# Registrar en cada consola el callback correspondiente. En release, agregar
# también las variantes http://localhost:5001..5004 antes de la ruta.
# ---------------------------------------------------------------------------
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_CALLBACK_PATH=/signin-discord

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_CALLBACK_PATH=/signin-spotify

DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
DROPBOX_CALLBACK_PATH=/signin-dropbox

SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_CALLBACK_PATH=/signin-slack

TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_CALLBACK_PATH=/signin-twitch

TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_CALLBACK_PATH=/signin-twitter
